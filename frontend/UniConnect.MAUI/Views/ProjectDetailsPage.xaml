<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniConnect.MAUI.Models"
             x:Class="UniConnect.MAUI.Views.ProjectDetailsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="Project details">

    <ScrollView>
        <VerticalStackLayout Padding="22,18,22,35"
                             Spacing="20"
                             MaximumWidthRequest="500">

            <!-- HEADER -->
            <Grid ColumnDefinitions="40,*,40">
                <Path Grid.Column="0"
                      Data="M15 5 L8 12 L15 19"
                      Stroke="#171717"
                      StrokeThickness="2.5"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      Aspect="Uniform"
                      WidthRequest="22"
                      HeightRequest="22"
                      HorizontalOptions="Start"
                      VerticalOptions="Center">
                    <Path.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Path.GestureRecognizers>
                </Path>

                <Label Grid.Column="1"
                       Text="Project details"
                       FontSize="21"
                       FontAttributes="Bold"
                       TextColor="#171717"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="#DC2626"
                   FontSize="12" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#171717" />

            <!-- PROJECT DETAILS -->
            <Border BackgroundColor="White"
                    Stroke="#E3E3E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="PROJECT DETAILS"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.3"
                               TextColor="#888888"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="Edit details"
                                Clicked="OnEditDetailsClicked"
                                IsVisible="{Binding IsLeader}"
                                BackgroundColor="#171717"
                                TextColor="White"
                                CornerRadius="22"
                                HeightRequest="40"
                                Padding="16,0"
                                FontSize="12"
                                FontAttributes="Bold" />
                    </Grid>

                    <!-- NORMAL VIEW -->
                    <VerticalStackLayout IsVisible="{Binding IsViewingDetails}"
                                         Spacing="12">

                        <Label Text="{Binding ProjectName}"
                               FontSize="23"
                               FontAttributes="Bold"
                               TextColor="#171717" />

                        <Label Text="{Binding RoleText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#333333" />

                        <Label Text="{Binding Description}"
                               FontSize="14"
                               TextColor="#777777"
                               LineBreakMode="WordWrap" />

                        <BoxView HeightRequest="1"
                                 Color="#EEEEEE" />

                        <Grid ColumnDefinitions="105,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="12">

                            <Label Grid.Row="0"
                                   Text="Start date"
                                   FontSize="12"
                                   TextColor="#999999" />

                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding StartText}"
                                   FontSize="13"
                                   TextColor="#222222" />

                            <Label Grid.Row="1"
                                   Text="Due date"
                                   FontSize="12"
                                   TextColor="#999999" />

                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding EndText}"
                                   FontSize="13"
                                   TextColor="#222222" />

                            <Label Grid.Row="2"
                                   Text="Status"
                                   FontSize="12"
                                   TextColor="#999999" />

                            <Border Grid.Row="2"
                                    Grid.Column="1"
                                    BackgroundColor="#F1F1F1"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,4"
                                    HorizontalOptions="Start">

                                <Label Text="{Binding StatusText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#222222" />
                            </Border>

                            <Label Grid.Row="3"
                                   Text="Project file"
                                   FontSize="12"
                                   TextColor="#999999" />

                            <Label Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding FileText}"
                                   FontSize="13"
                                   TextColor="#171717">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProjectFileTapped" />
                                </Label.GestureRecognizers>
                            </Label>

                        </Grid>
                    </VerticalStackLayout>

                    <!-- EDIT VIEW -->
                    <VerticalStackLayout IsVisible="{Binding IsEditing}"
                                         Spacing="12">

                        <Label Text="Edit project information"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#171717" />

                        <Label Text="Project name"
                               FontSize="12"
                               TextColor="#777777" />

                        <Border Stroke="#DDDDDD"
                                StrokeShape="RoundRectangle 11"
                                Padding="10,0">
                            <Entry Text="{Binding EditProjectName}"
                                   Placeholder="Enter project name"
                                   TextColor="#171717"
                                   FontSize="14"
                                   MaxLength="100" />
                        </Border>

                        <Label Text="Description"
                               FontSize="12"
                               TextColor="#777777" />

                        <Border Stroke="#DDDDDD"
                                StrokeShape="RoundRectangle 11"
                                Padding="10">
                            <Editor Text="{Binding EditDescription}"
                                    Placeholder="Project description"
                                    TextColor="#171717"
                                    FontSize="14"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="90" />
                        </Border>

                        <Label Text="Start date"
                               FontSize="12"
                               TextColor="#777777" />

                        <DatePicker Date="{Binding EditStartDate}"
                                    TextColor="#171717"
                                    BackgroundColor="White" />

                        <Label Text="Due date"
                               FontSize="12"
                               TextColor="#777777" />

                        <DatePicker Date="{Binding EditEndDate}"
                                    TextColor="#171717"
                                    BackgroundColor="White" />

                        <Label Text="Project status"
                               FontSize="12"
                               TextColor="#777777" />

                        <Border Stroke="#DDDDDD"
                                StrokeShape="RoundRectangle 11"
                                Padding="8,0">
                            <Picker ItemsSource="{Binding StatusOptions}"
                                    SelectedItem="{Binding EditStatus}"
                                    TextColor="#171717"
                                    Title="Select status" />
                        </Border>

                        <Label Text="Project code"
                               FontSize="12"
                               TextColor="#777777" />

                        <Border BackgroundColor="#F3F3F3"
                                Stroke="#E5E5E5"
                                StrokeShape="RoundRectangle 11"
                                Padding="12">
                            <Label Text="{Binding CodeText}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   CharacterSpacing="3"
                                   TextColor="#555555" />
                        </Border>

                        <Label Text="The project code cannot be changed."
                               FontSize="11"
                               TextColor="#999999" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">

                            <Button Text="Cancel"
                                    Clicked="OnCancelEditClicked"
                                    BackgroundColor="White"
                                    TextColor="#171717"
                                    BorderColor="#DDDDDD"
                                    BorderWidth="1"
                                    CornerRadius="22"
                                    HeightRequest="46" />

                            <Button Grid.Column="1"
                                    Text="Save changes"
                                    Clicked="OnSaveDetailsClicked"
                                    BackgroundColor="#171717"
                                    TextColor="White"
                                    CornerRadius="22"
                                    HeightRequest="46"
                                    FontAttributes="Bold" />
                        </Grid>

                    </VerticalStackLayout>

                    <!-- PROJECT CODE -->
                    <Border BackgroundColor="#F3F3F3"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14"
                            Padding="15">

                        <VerticalStackLayout Spacing="7">

                            <Label Text="PROJECT CODE"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.3"
                                   TextColor="#777777" />

                            <Label Text="{Binding CodeText}"
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   CharacterSpacing="4"
                                   TextColor="#171717" />

                            <Label Text="Share this code with teammates so they can join your project."
                                   FontSize="11"
                                   TextColor="#777777" />

                            <Button Text="Copy code"
                                    Clicked="OnCopyCodeClicked"
                                    IsVisible="{Binding HasCode}"
                                    HorizontalOptions="Start"
                                    HeightRequest="40"
                                    Padding="18,0"
                                    CornerRadius="22"
                                    FontSize="12"
                                    BackgroundColor="White"
                                    TextColor="#171717"
                                    BorderColor="#171717"
                                    BorderWidth="1" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- PROJECT FILES -->
            <Border BackgroundColor="White"
                    Stroke="#E3E3E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="PROJECT FILES"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.3"
                               TextColor="#888888" />

                        <Label Grid.Column="1"
                               Text="{Binding FileCountText}"
                               FontSize="12"
                               TextColor="#999999" />
                    </Grid>

                    <Label Text="Documents and pictures shared with this project."
                           FontSize="12"
                           TextColor="#888888" />

                    <Label Text="No files yet. Upload the brief, notes or pictures."
                           IsVisible="{Binding HasNoFiles}"
                           FontSize="13"
                           TextColor="#777777"
                           Margin="0,5" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Files}"
                                         Spacing="0">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectFileModel">

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12"
                                      Padding="0,13">

                                    <Path Grid.Column="0"
                                          Data="M6 2 H14 L19 7 V22 H6 Z M14 2 V7 H19"
                                          Stroke="#333333"
                                          StrokeThickness="1.8"
                                          Aspect="Uniform"
                                          WidthRequest="22"
                                          HeightRequest="24"
                                          VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">

                                        <Label Text="{Binding FileName}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               TextColor="#222222"
                                               LineBreakMode="MiddleTruncation" />

                                        <Label Text="{Binding InfoText}"
                                               FontSize="11"
                                               TextColor="#999999" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="2"
                                            Text="Delete"
                                            Clicked="OnDeleteFileClicked"
                                            IsVisible="{Binding CanDelete}"
                                            VerticalOptions="Center"
                                            HeightRequest="34"
                                            Padding="13,0"
                                            CornerRadius="18"
                                            FontSize="11"
                                            BackgroundColor="White"
                                            TextColor="#DC2626"
                                            BorderColor="#F0CACA"
                                            BorderWidth="1" />

                                    <BoxView Grid.ColumnSpan="3"
                                             HeightRequest="1"
                                             Color="#EEEEEE"
                                             VerticalOptions="End" />

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFileTapped" />
                                    </Grid.GestureRecognizers>

                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Upload file or picture"
                            Clicked="OnUploadFileClicked"
                            BackgroundColor="#171717"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            HeightRequest="48"
                            Margin="0,5,0,0" />

                    <Label Text="Max 10 MB. PDF, Word, Excel, PowerPoint, text, zip, PNG or JPG. Only the uploader or Team Lead can delete a file."
                           FontSize="11"
                           TextColor="#999999" />

                </VerticalStackLayout>
            </Border>

            <!-- MEMBERS -->
            <Border BackgroundColor="White"
                    Stroke="#E3E3E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="MEMBERS"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.3"
                               TextColor="#888888" />

                        <Label Grid.Column="1"
                               Text="{Binding MemberCountText}"
                               FontSize="12"
                               TextColor="#999999" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}"
                                         Spacing="0">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectMemberModel">

                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="0,13">

                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="3">

                                        <Label Text="{Binding FullName}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="#222222" />

                                        <Label Text="{Binding Student.Email}"
                                               FontSize="12"
                                               TextColor="#999999" />

                                        <Label Text="{Binding RoleText}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#333333" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="Remove"
                                            Clicked="OnRemoveMemberClicked"
                                            IsVisible="{Binding CanRemove}"
                                            VerticalOptions="Center"
                                            HeightRequest="36"
                                            Padding="14,0"
                                            CornerRadius="19"
                                            FontSize="11"
                                            BackgroundColor="White"
                                            TextColor="#DC2626"
                                            BorderColor="#F0CACA"
                                            BorderWidth="1" />

                                    <BoxView Grid.ColumnSpan="2"
                                             HeightRequest="1"
                                             Color="#EEEEEE"
                                             VerticalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ADD MEMBER -->
                    <VerticalStackLayout IsVisible="{Binding IsLeader}"
                                         Spacing="9"
                                         Margin="0,5,0,0">

                        <Label Text="Add a member by student email"
                               FontSize="12"
                               TextColor="#888888" />

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">

                            <Border Stroke="#DDDDDD"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,0">
                                <Entry x:Name="AddEmailEntry"
                                       Placeholder="student@example.com"
                                       Keyboard="Email"
                                       FontSize="14"
                                       TextColor="#222222" />
                            </Border>

                            <Button Grid.Column="1"
                                    Text="Add"
                                    Clicked="OnAddMemberClicked"
                                    BackgroundColor="#171717"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="46"
                                    Padding="20,0"
                                    FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- PROJECT ACTIONS -->
            <Border BackgroundColor="White"
                    Stroke="#E3E3E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="PROJECT ACTIONS"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.3"
                           TextColor="#888888" />

                    <!-- TEAM LEAD -->
                    <VerticalStackLayout IsVisible="{Binding IsLeader}"
                                         Spacing="10">

                        <Label Text="Remove members using the Members section above."
                               FontSize="12"
                               TextColor="#888888" />

                        <Label Text="Disbanding permanently deletes the project, its tasks and chat for everyone. This cannot be undone."
                               FontSize="12"
                               TextColor="#777777" />

                        <Button Text="Disband project"
                                Clicked="OnDisbandClicked"
                                HeightRequest="47"
                                CornerRadius="24"
                                FontAttributes="Bold"
                                BackgroundColor="White"
                                TextColor="#DC2626"
                                BorderColor="#F0CACA"
                                BorderWidth="1" />
                    </VerticalStackLayout>

                    <!-- TEAM MEMBER -->
                    <VerticalStackLayout IsVisible="{Binding IsNotLeader}"
                                         Spacing="10">

                        <Label Text="Only the Team Lead can add or remove members and disband the project."
                               FontSize="12"
                               TextColor="#888888" />

                        <Label Text="Leaving removes your access to this project. You can rejoin later with the project code."
                               FontSize="12"
                               TextColor="#777777" />

                        <Button Text="Leave project"
                                Clicked="OnLeaveClicked"
                                HeightRequest="47"
                                CornerRadius="24"
                                FontAttributes="Bold"
                                BackgroundColor="White"
                                TextColor="#DC2626"
                                BorderColor="#F0CACA"
                                BorderWidth="1" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
