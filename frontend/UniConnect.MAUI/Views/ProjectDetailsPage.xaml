<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniConnect.MAUI.Models"
             x:Class="UniConnect.MAUI.Views.ProjectDetailsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="Project details">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,40" Spacing="18" MaximumWidthRequest="500">

            <!-- Header -->
            <Grid ColumnDefinitions="40,*,40">
                <Path Grid.Column="0" Data="M15 5 L8 12 L15 19" Stroke="Black" StrokeThickness="2.5"
                      StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                      WidthRequest="22" HeightRequest="22" HorizontalOptions="Start"
                      VerticalOptions="Center" SemanticProperties.Description="Back">
                    <Path.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Path.GestureRecognizers>
                </Path>
                <Label Grid.Column="1" Text="Project details" FontSize="22" FontAttributes="Bold"
                       TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="12" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="Black" />

            <!-- ============ SECTION 1: PROJECT DETAILS + CODE ============ -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="1  PROJECT DETAILS" FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="1.5" TextColor="Gray" />

                    <Label Text="{Binding ProjectName}" FontSize="20" FontAttributes="Bold" TextColor="Black" />

                    <Label Text="{Binding RoleText}" FontSize="12" FontAttributes="Bold" TextColor="Gray">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsLeader}" Value="True">
                                <Setter Property="TextColor" Value="#1E3A8A" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="{Binding Description}" FontSize="13" TextColor="#374151" />

                    <BoxView HeightRequest="1" Color="#E5E5E5" />

                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Text="Start date" FontSize="12" TextColor="Gray" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding StartText}" FontSize="13" TextColor="Black" />
                        <Label Grid.Row="1" Text="Due date" FontSize="12" TextColor="Gray" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding EndText}" FontSize="13" TextColor="Black" />
                        <Label Grid.Row="2" Text="Status" FontSize="12" TextColor="Gray" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" FontSize="13" TextColor="Black" />
                        <Label Grid.Row="3" Text="Project file" FontSize="12" TextColor="Gray" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding FileText}" FontSize="13" TextColor="Black" />
                    </Grid>

                    <!-- Project code: share it so teammates can join from Projects > Join with Code -->
                    <Border BackgroundColor="#E8F1FE" Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="PROJECT CODE" FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1.5" TextColor="#1E3A8A" />
                            <Label Text="{Binding CodeText}" FontSize="28" FontAttributes="Bold"
                                   CharacterSpacing="4" TextColor="#1E3A8A" />
                            <Label Text="Share this code. Teammates enter it under Projects, Join with Code."
                                   FontSize="11" TextColor="#374151" />
                            <Button Text="Copy code" Clicked="OnCopyCodeClicked" IsVisible="{Binding HasCode}"
                                    HorizontalOptions="Start" HeightRequest="36" Padding="18,0" CornerRadius="18"
                                    FontSize="12" BackgroundColor="White" TextColor="#1E3A8A"
                                    BorderColor="#1E3A8A" BorderWidth="1" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ============ SECTION 2: PROJECT FILES ============ -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="2  PROJECT FILES" FontSize="11" FontAttributes="Bold"
                               CharacterSpacing="1.5" TextColor="Gray" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding FileCountText}" FontSize="12" TextColor="Gray" />
                    </Grid>

                    <Label Text="Documents and pictures for this project. Any member can upload; tap a file to open it."
                           FontSize="12" TextColor="Gray" />

                    <Label Text="No files yet. Upload the brief, notes or pictures."
                           IsVisible="{Binding HasNoFiles}" FontSize="13" TextColor="#374151" Margin="0,6" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Files}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectFileModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12">
                                    <Path Grid.Column="0" Data="M6 2 H14 L19 7 V22 H6 Z M14 2 V7 H19"
                                          Stroke="Black" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                          Aspect="Uniform" WidthRequest="22" HeightRequest="24" VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding FileName}" FontAttributes="Bold" FontSize="13"
                                               TextColor="Black" LineBreakMode="MiddleTruncation" />
                                        <Label Text="{Binding InfoText}" FontSize="11" TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <!-- Uploader or Team Lead only (CanDelete is false for everyone else) -->
                                    <Button Grid.Column="2" Text="Delete" Clicked="OnDeleteFileClicked"
                                            IsVisible="{Binding CanDelete}" VerticalOptions="Center"
                                            HeightRequest="34" Padding="14,0" CornerRadius="17" FontSize="12"
                                            BackgroundColor="Transparent" TextColor="#DC2626"
                                            BorderColor="#DC2626" BorderWidth="1" />

                                    <BoxView Grid.ColumnSpan="3" HeightRequest="1" Color="#EEEEEE" VerticalOptions="End" />

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFileTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Any project member can upload -->
                    <Button Text="Upload file or picture" Clicked="OnUploadFileClicked"
                            BackgroundColor="Black" TextColor="White" FontAttributes="Bold"
                            CornerRadius="23" HeightRequest="46" Margin="0,6,0,0" />
                    <Label Text="Max 10 MB. PDF, Word, Excel, PowerPoint, text, zip, PNG or JPG. Only the uploader or the Team Lead can delete a file."
                           FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ SECTION 3: MEMBERS ============ -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="3  MEMBERS" FontSize="11" FontAttributes="Bold"
                               CharacterSpacing="1.5" TextColor="Gray" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding MemberCountText}" FontSize="12" TextColor="Gray" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectMemberModel">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="14" TextColor="Black" />
                                        <Label Text="{Binding Email}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding RoleText}" FontSize="11" FontAttributes="Bold" TextColor="Gray">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsLeader}" Value="True">
                                                    <Setter Property="TextColor" Value="#1E3A8A" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>

                                    <!-- Team Lead only (CanRemove is false for everyone else) -->
                                    <Button Grid.Column="1" Text="Remove" Clicked="OnRemoveMemberClicked"
                                            IsVisible="{Binding CanRemove}" VerticalOptions="Center"
                                            HeightRequest="34" Padding="14,0" CornerRadius="17" FontSize="12"
                                            BackgroundColor="Transparent" TextColor="#DC2626"
                                            BorderColor="#DC2626" BorderWidth="1" />

                                    <BoxView Grid.ColumnSpan="2" HeightRequest="1" Color="#EEEEEE" VerticalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Add member: Team Lead only -->
                    <VerticalStackLayout IsVisible="{Binding IsLeader}" Spacing="8" Margin="0,6,0,0">
                        <Label Text="Add a member by student email" FontSize="12" TextColor="Gray" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Stroke="Black" StrokeShape="RoundRectangle 12" Padding="10,0">
                                <Entry x:Name="AddEmailEntry" Placeholder="student@example.com"
                                       Keyboard="Email" FontSize="14" TextColor="Black" />
                            </Border>
                            <Button Grid.Column="1" Text="Add" Clicked="OnAddMemberClicked"
                                    BackgroundColor="Black" TextColor="White" CornerRadius="12"
                                    HeightRequest="44" Padding="20,0" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ============ SECTION 4: PROJECT ACTIONS ============ -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="4  PROJECT ACTIONS" FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="1.5" TextColor="Gray" />

                    <!-- Team Lead -->
                    <VerticalStackLayout IsVisible="{Binding IsLeader}" Spacing="10">
                        <Label Text="Remove a member with the Remove button in the Members section above."
                               FontSize="12" TextColor="Gray" />
                        <Label Text="Disbanding permanently deletes the project, its tasks and its chat for everyone. This can't be undone."
                               FontSize="12" TextColor="#374151" />
                        <Button Text="Disband project" Clicked="OnDisbandClicked"
                                HeightRequest="46" CornerRadius="23" FontAttributes="Bold"
                                BackgroundColor="Transparent" TextColor="#DC2626"
                                BorderColor="#DC2626" BorderWidth="1" />
                    </VerticalStackLayout>

                    <!-- Team Member -->
                    <VerticalStackLayout IsVisible="{Binding IsNotLeader}" Spacing="10">
                        <Label Text="Only the Team Lead can add or remove members and disband the project."
                               FontSize="12" TextColor="Gray" />
                        <Label Text="Leaving removes your access to this project. You can rejoin later with the project code."
                               FontSize="12" TextColor="#374151" />
                        <Button Text="Leave project" Clicked="OnLeaveClicked"
                                HeightRequest="46" CornerRadius="23" FontAttributes="Bold"
                                BackgroundColor="Transparent" TextColor="#DC2626"
                                BorderColor="#DC2626" BorderWidth="1" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
