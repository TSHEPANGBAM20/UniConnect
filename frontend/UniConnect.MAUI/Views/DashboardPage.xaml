<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:UniConnect.MAUI.Models"
    xmlns:controls="clr-namespace:UniConnect.MAUI.Controls"
    x:Class="UniConnect.MAUI.Views.DashboardPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}"
    Title="Dashboard">

    <Grid>

        <ScrollView>
            <VerticalStackLayout
                Padding="22,30,22,125"
                Spacing="0"
                MaximumWidthRequest="520"
                HorizontalOptions="Center">

                <!-- Header -->
                <VerticalStackLayout
                    Spacing="3"
                    Margin="0,0,0,32">

                    <Label
                        Text="UniConnect"
                        FontSize="24"
                        FontAttributes="Bold"
                        CharacterSpacing="-1"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Your workspace"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                </VerticalStackLayout>

                <!-- Welcome -->
                <VerticalStackLayout
                    Spacing="6"
                    Margin="0,0,0,25">

                    <Label
                        Text="{Binding WelcomeMessage}"
                        FontSize="28"
                        FontAttributes="Bold"
                        CharacterSpacing="-0.5"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Stay organised. Keep your team moving."
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                </VerticalStackLayout>

                <!-- Dashboard actions -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    Margin="0,0,0,30">

                    <Button
                        Grid.Column="0"
                        Text="+ New Project"
                        Clicked="OnNewProjectClicked"
                        BackgroundColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                        TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}"
                        CornerRadius="22"
                        HeightRequest="52"
                        Padding="8,0"
                        FontSize="13"
                        FontAttributes="Bold" />

                    <Button
                        Grid.Column="1"
                        Text="Join with Code"
                        Clicked="OnJoinWithCodeClicked"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                        BorderColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                        BorderWidth="1.5"
                        CornerRadius="22"
                        HeightRequest="52"
                        Padding="8,0"
                        FontSize="13"
                        FontAttributes="Bold" />

                </Grid>

                <!-- Notifications heading -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,12">

                    <Label
                        Text="Notifications"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Recent"
                        Grid.Column="1"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                        VerticalOptions="Center" />

                </Grid>

                <!-- Empty notifications -->
                <Border
                    IsVisible="{Binding ShowEmptyNotifications}"
                    Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#333333}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1B1B1B}"
                    Margin="0,0,0,25">

                    <Label
                        Text="You're all caught up."
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                </Border>

                <!-- Notification cards -->
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Notifications}"
                    Spacing="10"
                    Margin="0,0,0,28">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationModel">

                            <Border
                                Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#333333}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#181818}">

                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding IsRead}"
                                        Value="True">

                                        <Setter
                                            Property="BackgroundColor"
                                            Value="{AppThemeBinding Light=#F7F7F7, Dark=#202020}" />

                                    </DataTrigger>
                                </Border.Triggers>

                                <VerticalStackLayout Spacing="8">

                                    <!-- Notification title and arrow -->
                                    <Grid
                                        ColumnDefinitions="*,Auto,Auto"
                                        ColumnSpacing="10">

                                        <Label
                                            Text="{Binding DisplayTitle}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                                            VerticalOptions="Center">

                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsRead}"
                                                    Value="True">

                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                                                </DataTrigger>
                                            </Label.Triggers>

                                        </Label>

                                        <Label
                                            Grid.Column="1"
                                            Text="UNREAD"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            CharacterSpacing="0.5"
                                            TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}"
                                            VerticalOptions="Center">

                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsRead}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Text"
                                                        Value="READ" />

                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{AppThemeBinding Light=#999999, Dark=#777777}" />

                                                </DataTrigger>
                                            </Label.Triggers>

                                        </Label>

                                        <!-- Right-facing arrow -->
                                        <Label
                                            Grid.Column="2"
                                            Text="›"
                                            FontSize="25"
                                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                    <!-- Notification message -->
                                    <Label
                                        Text="{Binding Message}"
                                        FontSize="12"
                                        LineBreakMode="WordWrap"
                                        TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />

                                    <!-- Related project name -->
                                    <Label
                                        Text="{Binding ProjectName}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                                    <!-- Divider -->
                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="{AppThemeBinding Light=#EAEAEA, Dark=#333333}"
                                        Margin="0,3,0,2" />

                                    <!-- Deadline or message date -->
                                    <Label
                                        Text="{Binding DueDate, StringFormat='Due {0:dd MMM yyyy}'}"
                                        FontSize="11"
                                        TextColor="{AppThemeBinding Light=#888888, Dark=#999999}" />

                                </VerticalStackLayout>

                                <!-- Keep the entire notification clickable -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnNotificationTapped" />
                                </Border.GestureRecognizers>

                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

                <!-- Projects heading -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,12">

                    <Label
                        Text="Your Projects"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <!-- View all navigation -->
                    <Label
                        Text="View all"
                        Grid.Column="1"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                        VerticalOptions="Center">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnViewAllProjectsTapped" />
                        </Label.GestureRecognizers>

                    </Label>

                </Grid>

                <!-- Empty projects -->
                <Border
                    IsVisible="{Binding ShowEmptyProjects}"
                    Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#333333}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1B1B1B}"
                    Margin="0,0,0,25">

                    <VerticalStackLayout
                        Spacing="7"
                        HorizontalOptions="Center">

                        <Label
                            Text="No projects yet"
                            FontSize="15"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <Label
                            Text="Create a project to start working with your team."
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                    </VerticalStackLayout>

                </Border>

                <!-- Project cards -->
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Projects}"
                    Spacing="12"
                    Margin="0,0,0,28">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectModel">

                            <Border
                                Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#333333}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#181818}">

                                <VerticalStackLayout Spacing="12">

                                    <!-- Project name -->
                                    <Label
                                        Text="{Binding ProjectName}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                                    <!-- Project due date -->
                                    <Label
                                        Text="{Binding EndDate, StringFormat='Due {0:dd MMM yyyy}'}"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                                    <!-- Divider -->
                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="{AppThemeBinding Light=#E5E5E5, Dark=#333333}"
                                        HorizontalOptions="Fill" />

                                    <!-- Open project -->
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="Open project"
                                            FontSize="12"
                                            FontAttributes="None"
                                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="›"
                                            Grid.Column="1"
                                            FontSize="24"
                                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </VerticalStackLayout>

                                <!-- Project navigation -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnProjectTapped" />
                                </Border.GestureRecognizers>

                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <controls:BottomNavBar
            ActiveTab="Home"
            VerticalOptions="End"
            TabSelected="OnTabSelected"
            MenuItemSelected="OnMenuItemSelected" />

        <!-- Loading -->
        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

    </Grid>

</ContentPage>
