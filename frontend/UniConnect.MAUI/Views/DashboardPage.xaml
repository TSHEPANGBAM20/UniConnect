<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:UniConnect.MAUI.Models"
    xmlns:controls="clr-namespace:UniConnect.MAUI.Controls"
    x:Class="UniConnect.MAUI.Views.DashboardPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}"
    Title="Dashboard">

    <Grid>

        <!-- Main scrollable content -->
        <ScrollView>

            <VerticalStackLayout
                Padding="22,30,22,125"
                Spacing="0"
                MaximumWidthRequest="520"
                HorizontalOptions="Center">

                <!-- Header -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,32">

                    <VerticalStackLayout
                        Spacing="3"
                        VerticalOptions="Center">

                        <Label
                            Text="UniConnect"
                            FontSize="24"
                            FontAttributes="Bold"
                            CharacterSpacing="-1"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <Label
                            Text="Your workspace"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#333333}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1B1B1B}">

                        <Label
                            Text="M"
                            FontSize="15"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    </Border>

                </Grid>

                <!-- Welcome -->

                <VerticalStackLayout
                    Spacing="6"
                    Margin="0,0,0,25">

                    <Label
                        Text="{Binding WelcomeMessage}" 
                        FontSize="28"
                        FontAttributes="Bold"
                        CharacterSpacing="-0.5"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Stay organised. Keep your team moving."
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                </VerticalStackLayout>

                <!-- New Project -->

                <Button
                    Text="+  New Project"
                    Clicked="OnNewProjectClicked"
                    BackgroundColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}"
                    CornerRadius="26"
                    HeightRequest="54"
                    FontSize="15"
                    FontAttributes="Bold"
                    Margin="0,0,0,30" />

                <!-- Projects heading -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,12">

                    <Label
                        Text="Your Projects"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="View all"
                        Grid.Column="1"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                        VerticalOptions="Center" />

                </Grid>

                <!-- Empty projects -->

                <Border
                    IsVisible="{Binding ShowEmptyProjects}"
                    Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#333333}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1B1B1B}"
                    Margin="0,0,0,25">

                    <VerticalStackLayout
                        Spacing="7"
                        HorizontalOptions="Center">

                        <Label
                            Text="No projects yet"
                            FontSize="15"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <Label
                            Text="Create a project to start working with your team."
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                    </VerticalStackLayout>

                </Border>

                <!-- Project cards -->

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Projects}"
                    Spacing="12"
                    Margin="0,0,0,28">

                    <BindableLayout.ItemTemplate>

                        <DataTemplate x:DataType="models:ProjectModel">

                            <Border
                                Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#333333}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="17"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#181818}">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="5">

                                    <Label
                                        Text="{Binding ProjectName}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                                    <Label
                                        Text="›"
                                        Grid.Column="1"
                                        Grid.RowSpan="2"
                                        FontSize="25"
                                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Text="{Binding Role}"
                                        Grid.Row="1"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                                </Grid>

                                <Border.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="OnProjectTapped" />

                                </Border.GestureRecognizers>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

                <!-- Divider -->

                <BoxView
                    HeightRequest="1"
                    Color="{AppThemeBinding Light=#E5E5E5, Dark=#2C2C2C}"
                    Margin="0,0,0,25" />

                <!-- Notifications -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,12">

                    <Label
                        Text="Notifications"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Recent"
                        Grid.Column="1"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                        VerticalOptions="Center" />

                </Grid>

                <!-- Empty notifications -->

                <Border
                    IsVisible="{Binding ShowEmptyNotifications}"
                    Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#333333}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1B1B1B}">

                    <Label
                        Text="You're all caught up."
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                </Border>

                <!-- Notification cards -->

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Notifications}"
                    Spacing="10">

                    <BindableLayout.ItemTemplate>

                        <DataTemplate x:DataType="models:NotificationModel">

                            <Border
                                Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#333333}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="15"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#181818}">

                                <Label
                                    Text="{Binding Message}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}">

                                    <Label.Triggers>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding IsRead}"
                                            Value="True">

                                            <Setter
                                                Property="FontAttributes"
                                                Value="None" />

                                            <Setter
                                                Property="TextColor"
                                                Value="{AppThemeBinding Light=#888888, Dark=#777777}" />

                                        </DataTrigger>

                                    </Label.Triggers>

                                </Label>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Bottom navigation -->

        <controls:BottomNavBar
            ActiveTab="Home"
            VerticalOptions="End"
            TabSelected="OnTabSelected"
            MenuItemSelected="OnMenuItemSelected" />

        <!-- Loading -->

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

    </Grid>

</ContentPage>