<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          xmlns:models="clr-namespace:UniConnect.MAUI.Models"
          xmlns:controls="clr-namespace:UniConnect.MAUI.Controls"
          x:Class="UniConnect.MAUI.Views.TaskBoardPage"
          Shell.NavBarIsVisible="False"
          BackgroundColor="White"
          Title="Tasks">

<Grid MaximumWidthRequest="500">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Padding="20,16,20,8">
            <Path Grid.Column="0" Data="M4 6 H20 M4 12 H20 M4 18 H20"
                  Stroke="Black" StrokeThickness="2" StrokeLineCap="Round"
                  Aspect="Uniform" WidthRequest="24" HeightRequest="24"
                  HorizontalOptions="Start" VerticalOptions="Center"
                  SemanticProperties.Description="Project menu">
                <Path.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuTapped" />
                </Path.GestureRecognizers>
            </Path>

            <Label Grid.Column="1" Text="Tasks" FontSize="22" FontAttributes="Bold"
                   TextColor="Black" VerticalOptions="Center" />

            <Label Grid.Column="2" Text="Add New Task" FontSize="13"
                   TextColor="Black" HorizontalOptions="End" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddTaskTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <Label Grid.Row="1" Text="{Binding ErrorMessage}" TextColor="#DC2626"
               FontSize="12" Margin="20,0" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Tasks}" Margin="20,8,20,0">

            <CollectionView.EmptyView>
                <Label Text="No tasks yet." TextColor="Gray" FontSize="13"
                       HorizontalOptions="Center" Margin="0,30" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TaskModel">
                    <Border Stroke="Black" StrokeShape="RoundRectangle 16"
                            Padding="16,14" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="4">

                            <Label Grid.Row="0" Text="{Binding TaskTitle}"
                                   FontAttributes="Bold" FontSize="14"
                                   TextColor="Black" />

                            <Label Grid.Row="1" FontSize="11" TextColor="Gray">
                                <Label.Text>
                                    <MultiBinding StringFormat="Due: {0:dd MMM} - Assigned To {1}">
                                        <Binding Path="DueDate" />
                                        <Binding Path="AssignedToName" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <Button Grid.Row="2" Text="Done" Clicked="OnDoneClicked"
                                    HorizontalOptions="Start" HeightRequest="34"
                                    Padding="18,0" Margin="0,6,0,0"
                                    CornerRadius="10" FontSize="12"
                                    BackgroundColor="Transparent" TextColor="Black"
                                    BorderColor="Black" BorderWidth="1">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding Status}"
                                                 Value="DONE">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Path Grid.Column="1" Grid.RowSpan="3"
                                  Data="M5 12 L10 17 L19 7"
                                  Stroke="Black" StrokeThickness="2.5"
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Aspect="Uniform" WidthRequest="22"
                                  HeightRequest="22" VerticalOptions="Center"
                                  IsVisible="False">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path"
                                                 Binding="{Binding Status}"
                                                 Value="DONE">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout>
                    <Label Text="When you are done with a task, press the 'Done' button."
                           FontSize="11" TextColor="Gray" Margin="4,4,4,0" />
                    <Grid HeightRequest="120" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="Black"
                           VerticalOptions="Start"
                           Margin="0,20" />
    </Grid>

    <!-- Project drawer overlay -->
    <Grid x:Name="ProjectDrawerOverlay"
          IsVisible="False"
          ZIndex="10">

        <!-- Dark backdrop; tapping it closes the drawer -->
        <BoxView x:Name="DrawerBackdrop"
                 Color="#80000000"
                 Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDrawerBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Drawer panel -->
        <Border x:Name="ProjectDrawer"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                WidthRequest="300"
                TranslationX="-320"
                BackgroundColor="White"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20"
                Padding="20,24">

            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Text="Project Menu"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="Black"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="✕"
                            Clicked="OnCloseDrawerClicked"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            FontSize="20"
                            Padding="8,0"
                            VerticalOptions="Center" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="6">

            <Button Text="Tasks"
            CommandParameter="Tasks"
            Clicked="OnProjectMenuItemClicked"
            BackgroundColor="Transparent"
            TextColor="Black"
            HorizontalOptions="Fill" />

            <Button Text="Project Details"
            CommandParameter="Project Details"
            Clicked="OnProjectMenuItemClicked"
            BackgroundColor="Transparent"
            TextColor="Black"
            HorizontalOptions="Fill" />

            <Button Text="Project Chat"
            CommandParameter="Project Chat"
            Clicked="OnProjectMenuItemClicked"
            BackgroundColor="Transparent"
            TextColor="Black"
            HorizontalOptions="Fill" />

                    </VerticalStackLayout>
                </ScrollView>

                <Label Grid.Row="2"
                       Text="UniConnect"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="Center" />

            </Grid>
        </Border>
    </Grid>

    <!-- Existing bottom navigation -->
    <controls:BottomNavBar ActiveTab="Projects"
                           VerticalOptions="End"
                           ZIndex="5"
                           TabSelected="OnTabSelected"
                           MenuItemSelected="OnMenuItemSelected" />

</Grid>


</ContentPage>
