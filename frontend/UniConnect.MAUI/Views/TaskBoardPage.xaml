<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniConnect.MAUI.Models"
             xmlns:controls="clr-namespace:UniConnect.MAUI.Controls"
             x:Class="UniConnect.MAUI.Views.TaskBoardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8FC"
             Title="Tasks">

    <Grid MaximumWidthRequest="500">

        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Page header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Padding="20,20,20,16"
                  ColumnSpacing="14">

                <Path Grid.Column="0"
                      Data="M4 6 H20 M4 12 H20 M4 18 H20"
                      Stroke="#20213F"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      Aspect="Uniform"
                      WidthRequest="24"
                      HeightRequest="24"
                      VerticalOptions="Center">

                    <Path.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Path.GestureRecognizers>
                </Path>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">

                    <Label Text="My Tasks"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#20213F" />

                    <Label Text="Keep track of your project activities"
                           FontSize="12"
                           TextColor="#626579" />

                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="+ New Task"
                        Clicked="OnAddTaskTapped"
                        IsVisible="{Binding IsTeamLeader}"
                        BackgroundColor="Black"
                        TextColor="White"
                        FontSize="12"
                        FontAttributes="Bold"
                        CornerRadius="13"
                        Padding="12,0"
                        HeightRequest="44"
                        VerticalOptions="Center" />

            </Grid>

            <!-- Error message -->
            <Label Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   TextColor="#C62828"
                   FontSize="12"
                   Margin="20,0,20,8" />

            <!-- Tasks list -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Tasks}"
                            Margin="18,4,18,0"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="9"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="24">

                        <Label Text="No tasks yet"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#252653"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Tasks assigned to this project will appear here."
                               FontSize="13"
                               TextColor="#626579"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskModel">

                        <Border BackgroundColor="White"
                                Stroke="#E1E3EC"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="0,0,0,15">

                            <VerticalStackLayout Spacing="6">

                                <!-- Task title and status -->
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Label Grid.Column="0"
                                           Text="{Binding TaskTitle}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="#20213F"
                                           VerticalOptions="Center" />

                                    <Border Grid.Column="1"
                                            BackgroundColor="#FFF0CB"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            Padding="11,6"
                                            VerticalOptions="Center">

                                        <Border.Triggers>

                                            <!-- Overdue -->
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsOverdue}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor"
                                                        Value="#FDE2E2" />
                                            </DataTrigger>

                                            <!-- Completed -->
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsCompleted}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor"
                                                        Value="#D9F4E2" />
                                            </DataTrigger>

                                            <!-- In progress -->
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding Status}"
                                                         Value="IN_PROGRESS">
                                                <Setter Property="BackgroundColor"
                                                        Value="#E1E9FF" />
                                            </DataTrigger>

                                        </Border.Triggers>

                                        <Label Text="{Binding DisplayStatus}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#874B00">

                                            <Label.Triggers>

                                                <!-- Overdue text -->
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsOverdue}"
                                                             Value="True">
                                                    <Setter Property="TextColor"
                                                            Value="#C62828" />
                                                </DataTrigger>

                                                <!-- Completed text -->
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsCompleted}"
                                                             Value="True">
                                                    <Setter Property="TextColor"
                                                            Value="#087A36" />
                                                </DataTrigger>

                                                <!-- In progress text -->
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Status}"
                                                             Value="IN_PROGRESS">
                                                    <Setter Property="TextColor"
                                                            Value="#244BAA" />
                                                </DataTrigger>

                                            </Label.Triggers>

                                        </Label>
                                    </Border>

                                </Grid>

                                <!-- Description -->
                                <Label Text="{Binding TaskDescription}"
                                       FontSize="13"
                                       TextColor="#42445A"
                                       LineHeight="1.2"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation" />

                                <!-- Divider -->
                                <BoxView HeightRequest="1"
                                         Color="#E3E4EB" />

                                <!-- Priority and due date -->
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="12">

                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="5">

                                        <Label Text="PRIORITY"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#626579" />

                                        <Border BackgroundColor="#FFE1E1"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="10,5"
                                                HorizontalOptions="Start">

                                            <Label Text="{Binding Priority}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#A51D1D" />
                                        </Border>

                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="5">

                                        <Label Text="DUE DATE"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#626579" />

                                        <Label Text="{Binding DueDate, StringFormat='{0:dd MMM yyyy}'}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#252653" />

                                    </VerticalStackLayout>

                                </Grid>

                                <!-- Assigned member -->
                                <VerticalStackLayout Spacing="5">

                                    <Label Text="ASSIGNED TO"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#626579" />

                                    <Label Text="{Binding AssignedToName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#20213F" />

                                </VerticalStackLayout>

                                <!-- Mark as Done -->
                                <Button Text="✓   Mark as Done"
                                        Clicked="OnDoneClicked"
                                        HeightRequest="43"
                                        CornerRadius="12"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        BackgroundColor="Black"
                                        TextColor="White"
                                        HorizontalOptions="Fill">

                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding IsCompleted}"
                                                     Value="True">
                                            <Setter Property="IsVisible"
                                                    Value="False" />
                                        </DataTrigger>
                                    </Button.Triggers>

                                </Button>

                                <!-- Completed message -->
                                <Label Text="✓ Completed"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#168342"
                                       IsVisible="{Binding IsCompleted}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Grid HeightRequest="110" />
                </CollectionView.Footer>

            </CollectionView>

            <!-- Loading indicator -->
            <ActivityIndicator Grid.Row="2"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#252653"
                               VerticalOptions="Start"
                               Margin="0,20" />

        </Grid>

        <!-- Project drawer -->
        <Grid x:Name="ProjectDrawerOverlay"
              IsVisible="False"
              ZIndex="10">

            <BoxView x:Name="DrawerBackdrop"
                     Color="#80000000"
                     Opacity="0">

                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDrawerBackdropTapped" />
                </BoxView.GestureRecognizers>

            </BoxView>

            <Border x:Name="ProjectDrawer"
                    HorizontalOptions="Start"
                    VerticalOptions="Fill"
                    WidthRequest="300"
                    TranslationX="-320"
                    BackgroundColor="White"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 20"
                    Padding="20,24">

                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="20">

                    <!-- Drawer heading -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto">

                        <Label Text="Project Menu"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#20213F"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="✕"
                                Clicked="OnCloseDrawerClicked"
                                BackgroundColor="Transparent"
                                TextColor="#20213F"
                                FontSize="20"
                                Padding="8,0"
                                VerticalOptions="Center" />

                    </Grid>

                    <!-- Drawer options -->
                    <ScrollView Grid.Row="1">

                        <VerticalStackLayout Spacing="4">

                            <Button Text="Tasks"
                                    CommandParameter="Tasks"
                                    Clicked="OnProjectMenuItemClicked"
                                    BackgroundColor="#F2F2F2"
                                    TextColor="#20213F"
                                    FontSize="16"
                                    FontAttributes="None"
                                    HeightRequest="52"
                                    CornerRadius="12"
                                    HorizontalOptions="Fill" />

                            <Button Text="Project Details"
                                    CommandParameter="Project Details"
                                    Clicked="OnProjectMenuItemClicked"
                                    BackgroundColor="#F2F2F2"
                                    TextColor="#20213F"
                                    FontSize="16"
                                    FontAttributes="None"
                                    HeightRequest="52"
                                    CornerRadius="12"
                                    HorizontalOptions="Fill" />

                            <Button Text="Project Chat"
                                    CommandParameter="Project Chat"
                                    Clicked="OnProjectMenuItemClicked"
                                    BackgroundColor="#F2F2F2"
                                    TextColor="#20213F"
                                    FontSize="16"
                                    FontAttributes="None"
                                    HeightRequest="52"
                                    CornerRadius="12"
                                    HorizontalOptions="Fill" />

                        </VerticalStackLayout>

                    </ScrollView>

                    <!-- Drawer footer -->
                    <Label Grid.Row="2"
                           Text="UniConnect"
                           FontSize="12"
                           TextColor="#777777"
                           HorizontalOptions="Center" />

                </Grid>

            </Border>

        </Grid>

        <!-- Bottom navigation -->
        <controls:BottomNavBar ActiveTab="Projects"
                               VerticalOptions="End"
                               ZIndex="5"
                               TabSelected="OnTabSelected"
                               MenuItemSelected="OnMenuItemSelected" />

    </Grid>

</ContentPage>
