<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniConnect.MAUI.Models"
             xmlns:controls="clr-namespace:UniConnect.MAUI.Controls"
             x:Class="UniConnect.MAUI.Views.ProjectsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="Projects">

    <Grid MaximumWidthRequest="500">

        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Page heading -->
            <VerticalStackLayout Grid.Row="0"
                                 Spacing="5"
                                 Margin="24,25,24,16">

                <Label Text="My Projects"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="Black" />

                <Label Text="Manage and track your work"
                       FontSize="14"
                       TextColor="#777777" />

            </VerticalStackLayout>

            <!-- Project action buttons -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="24,0,24,18">

                <Button Grid.Column="0"
                        Text="New Project"
                        Clicked="OnNewProjectClicked"
                        BackgroundColor="Black"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50" />

                <Button Grid.Column="1"
                        Text="Join with Code"
                        Clicked="OnJoinWithCodeClicked"
                        BackgroundColor="White"
                        TextColor="Black"
                        BorderColor="Black"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50" />

            </Grid>

            <!-- Project list -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Projects}"
                            Margin="24,0">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center"
                                         Margin="0,40">

                        <Label Text="No projects yet"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalOptions="Center" />

                        <Label Text="Create a new project or join one using a project code."
                               FontSize="13"
                               TextColor="Gray"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectModel">

                        <Border Stroke="#DDDDDD"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="White"
                                Padding="16"
                                Margin="0,0,0,14">

                            <VerticalStackLayout Spacing="10">

                                <Label Text="{Binding ProjectName}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="Black" />

                                <Label Text="{Binding EndDate, StringFormat='Due {0:dd MMM yyyy}'}"
                                       FontSize="12"
                                       TextColor="#777777" />

                                <BoxView HeightRequest="1"
                                         Color="#EEEEEE" />

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label Grid.Column="0"
                                           Text="Open project"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="Black"
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="›"
                                           FontSize="22"
                                           TextColor="#777777"
                                           VerticalOptions="Center" />

                                </Grid>

                            </VerticalStackLayout>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProjectTapped" />
                            </Border.GestureRecognizers>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Grid HeightRequest="120" />
                </CollectionView.Footer>

            </CollectionView>

            <!-- Loading indicator -->
            <ActivityIndicator Grid.Row="2"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="Black"
                               VerticalOptions="Start"
                               Margin="0,20" />

        </Grid>

        <!-- Bottom navigation -->
        <controls:BottomNavBar ActiveTab="Projects"
                               VerticalOptions="End"
                               TabSelected="OnTabSelected"
                               MenuItemSelected="OnMenuItemSelected" />

    </Grid>
</ContentPage>
