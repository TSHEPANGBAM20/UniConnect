<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniConnect.MAUI.Models"
             x:Class="UniConnect.MAUI.Views.ChatPage"
             Title="Chat">

    <Grid RowDefinitions="*,Auto">

        <CollectionView Grid.Row="0" ItemsSource="{Binding Messages}" Margin="15,10">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MessageModel">
                    <!-- TODO: add a BoolToAlignmentConverter later so IsOwnMessage right-aligns
                         your own messages, matching Mock Up 5. Kept simple for now so this compiles
                         without extra resource wiring. -->
                    <Frame Padding="10" Margin="0,3" CornerRadius="12">
                        <VerticalStackLayout>
                            <Label Text="{Binding SenderName}" FontSize="10" TextColor="Gray" />
                            <Label Text="{Binding Message}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="10">
            <Entry x:Name="MessageEntry" Grid.Column="0" Placeholder="Add a comment..." />
            <Button Grid.Column="1" Text="Send" Clicked="OnSendClicked" />
        </Grid>

    </Grid>
</ContentPage>
