<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:UniConnect.MAUI.Models"
    x:Class="UniConnect.MAUI.Views.ChatPage"
    Title="Chat"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F0F0F}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,20,24,14"
            Spacing="4">

            <Label
                Text="PROJECT CHAT"
                FontSize="11"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                CharacterSpacing="1.5" />

            <Label
                Text="Team Chat"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

            <BoxView
                HeightRequest="1"
                Margin="0,12,0,0"
                Color="{AppThemeBinding Light=#E5E5E5, Dark=#292929}" />

        </VerticalStackLayout>


        <!-- Messages -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Messages}"
            Margin="18,0"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="30"
                    Spacing="8"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="No messages yet"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Start the conversation with your team."
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:MessageModel">

                    <Border
                        Stroke="{AppThemeBinding Light=#E5E5E5, Dark=#2A2A2A}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1A1A1A}"
                        Padding="14,10"
                        Margin="0,5"
                        StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{Binding SenderName}"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />

                            <Label
                                Text="{Binding Message}"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- Message composer -->
        <Border
            Grid.Row="2"
            Padding="12"
            Margin="16,8,16,18"
            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E2E2E2, Dark=#2A2A2A}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                <Entry
                    x:Name="MessageEntry"
                    Grid.Column="0"
                    Placeholder="Write a message..."
                    Text="{Binding DraftMessage}"
                    PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    Text="Send"
                    Clicked="OnSendClicked"
                    IsEnabled="{Binding CanSend}"
                    BackgroundColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}"
                    CornerRadius="18"
                    HeightRequest="42"
                    Padding="18,0"
                    FontAttributes="Bold"
                    FontSize="13" />

            </Grid>

        </Border>

    </Grid>

</ContentPage>