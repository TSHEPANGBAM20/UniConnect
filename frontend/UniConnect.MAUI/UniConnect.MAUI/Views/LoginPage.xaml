<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniConnect.MAUI.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="Log In">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="18" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="420">

            <Label Text="UniConnect"
                   FontSize="30" FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center" />

            <Label Text="Welcome Back"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <Label Text="Email" FontAttributes="Bold" TextColor="Black" FontSize="13" />
            <Border Stroke="#D0D0D0" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="50">
                <Entry x:Name="EmailEntry"
                       Placeholder="Enter your email"
                       Keyboard="Email"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Border>

            <Label Text="Password" FontAttributes="Bold" TextColor="Black" FontSize="13" />
            <Border Stroke="#D0D0D0" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="50">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="PasswordEntry"
                           Grid.Column="0"
                           Placeholder="Enter your password"
                           IsPassword="True"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                    <Label x:Name="ShowPasswordLabel"
                           Grid.Column="1"
                           Text="Show"
                           TextColor="Black"
                           FontAttributes="Bold"
                           FontSize="13"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTogglePasswordVisibility" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Log In"
                    Clicked="OnLoginClicked"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,0" />

            <Button Text="Create an account"
                    Clicked="OnSignUpTapped"
                    BackgroundColor="Transparent"
                    TextColor="Black"
                    BorderColor="Black"
                    BorderWidth="1"
                    CornerRadius="10"
                    HeightRequest="50" />

            <Label Text="Forgot your password?"
                   HorizontalOptions="Center"
                   TextColor="Black"
                   FontAttributes="Bold"
                   FontSize="13"
                   Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>