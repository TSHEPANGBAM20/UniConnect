<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniConnect.MAUI.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Title="Log In">

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Label Text="Log in to your account"
               FontSize="22" FontAttributes="Bold"
               HorizontalOptions="Center" Margin="0,0,0,20" />

        <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

        <Label Text="{Binding ErrorMessage}" TextColor="Red" />

        <Button Text="Log In" Clicked="OnLoginClicked" Margin="0,10,0,0" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Label Text="Don't have an account? Sign Up"
               HorizontalOptions="Center" TextColor="Gray" FontSize="13"
               Margin="0,20,0,0">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSignUpTapped" />
            </Label.GestureRecognizers>
        </Label>

    </VerticalStackLayout>
</ContentPage>
