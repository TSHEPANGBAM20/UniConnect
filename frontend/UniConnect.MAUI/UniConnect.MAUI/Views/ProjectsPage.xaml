<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniConnect.MAUI.Models"
             xmlns:controls="clr-namespace:UniConnect.MAUI.Controls"
             x:Class="UniConnect.MAUI.Views.ProjectsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="Projects">

    <Grid MaximumWidthRequest="500">

        <Grid RowDefinitions="Auto,Auto,*">

            <Label Grid.Row="0" Text="Projects" FontSize="22" FontAttributes="Bold"
                   TextColor="Black" HorizontalOptions="Center" Margin="0,20,0,10" />

            <Button Grid.Row="1" Text="New Project" Clicked="OnNewProjectClicked"
                    BackgroundColor="Black" TextColor="White" FontAttributes="Bold"
                    CornerRadius="25" HeightRequest="50" Margin="24,6,24,12" />

            <CollectionView Grid.Row="2" ItemsSource="{Binding Projects}" Margin="24,0">

                <CollectionView.EmptyView>
                    <Label Text="No projects yet. Tap New Project to create one."
                           TextColor="Gray" FontSize="13" HorizontalOptions="Center" Margin="0,30" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectModel">
                        <Border Stroke="Black" StrokeShape="RoundRectangle 16"
                                Padding="16,14" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding ProjectName}" FontAttributes="Bold"
                                       FontSize="15" TextColor="Black" />

                                <Label Text="Team Member" FontSize="12" TextColor="Gray">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Role}" Value="TEAM_LEAD">
                                            <Setter Property="Text" Value="Team Lead" />
                                            <Setter Property="TextColor" Value="#1E3A8A" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="{Binding EndDate, StringFormat='Due {0:dd MMM yyyy}'}"
                                       FontSize="11" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProjectTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Grid HeightRequest="120" />
                </CollectionView.Footer>
            </CollectionView>

            <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="Black" VerticalOptions="Start" Margin="0,20" />
        </Grid>

        <controls:BottomNavBar ActiveTab="Projects" VerticalOptions="End"
                               TabSelected="OnTabSelected"
                               MenuItemSelected="OnMenuItemSelected" />
    </Grid>
</ContentPage>

