<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniConnect.MAUI.Models"
             x:Class="UniConnect.MAUI.Views.DashboardPage"
             Title="Dashboard">

    <Grid RowDefinitions="Auto,Auto,*">

        <Label Grid.Row="0" Text="{Binding WelcomeMessage}"
               FontSize="20" FontAttributes="Bold" Margin="20,20,20,10" />

        <Button Grid.Row="1" Text="+ New Project" Clicked="OnNewProjectClicked"
                Margin="20,0,20,10" />

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                            VerticalOptions="Start" Margin="0,10" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Projects}" Margin="20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ProjectModel">
                    <Frame Margin="0,5" Padding="15" CornerRadius="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding ProjectName}" FontAttributes="Bold" />
                            <Label Text="{Binding Role}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProjectTapped"
                                BindingContext="{Binding .}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
