<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UniConnect.MAUI.Views.HomePage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}">

    <ScrollView>

        <VerticalStackLayout
            Padding="22,25,22,45"
            Spacing="0"
            MaximumWidthRequest="520"
            HorizontalOptions="Center">

            <!-- Header -->

            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,0,0,22">

                <Label
                    Text="UniConnect"
                    FontSize="27"
                    FontAttributes="Bold"
                    CharacterSpacing="-1"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    Text="☰"
                    FontSize="23"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    WidthRequest="45"
                    HeightRequest="45"
                    Padding="0" />

            </Grid>

            <!-- Hero -->

            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 26"
                HeightRequest="300"
                BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#222222}"
                Margin="0,0,0,25">

                <Grid>

                    <Image
                        Source="https://images.unsplash.com/photo-1522202176988-66273c2fd55f"
                        Aspect="AspectFill" />

                    <BoxView
                        BackgroundColor="#55000000" />

                    <VerticalStackLayout
                        VerticalOptions="End"
                        Padding="22"
                        Spacing="7">

                        <Label
                            Text="BUILT FOR"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="2"
                            TextColor="White" />

                        <Label
                            Text="University teams."
                            FontSize="29"
                            FontAttributes="Bold"
                            TextColor="White"
                            LineBreakMode="WordWrap" />

                        <Label
                            Text="Plan. Connect. Get it done."
                            FontSize="14"
                            TextColor="#EEEEEE" />

                    </VerticalStackLayout>

                </Grid>

            </Border>

            <!-- Introduction -->

            <VerticalStackLayout
                Spacing="10"
                Margin="0,0,0,22">

                <Label
                    Text="Your university projects, connected."
                    FontSize="30"
                    FontAttributes="Bold"
                    CharacterSpacing="-0.5"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                <Label
                    Text="A simple workspace to manage projects, tasks, deadlines and your team in one place."
                    FontSize="15"
                    LineHeight="1.25"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#B8B8B8}" />

            </VerticalStackLayout>

            <!-- Main Actions -->

            <VerticalStackLayout
                Spacing="10"
                Margin="0,0,0,32">

                <Button
                    Text="Get Started"
                    Clicked="OnGetStartedClicked" 
                    BackgroundColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}"
                    CornerRadius="26"
                    HeightRequest="54"
                    FontSize="15"
                    FontAttributes="Bold" />

                <Button
                    Text="Log In"
                    Clicked="OnLoginClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    BorderColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    BorderWidth="1.5"
                    CornerRadius="26"
                    HeightRequest="54"
                    FontSize="15"
                    FontAttributes="Bold" />

                <Button
                    Text="Preview Dashboard"
                    Clicked="OnDashboardPreviewClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                    HeightRequest="45"
                    FontSize="13"
                    FontAttributes="Bold"
                    />

            </VerticalStackLayout>

            <!-- Project Search -->

            <Border
                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#333333}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#1B1B1B}"
                Padding="20"
                Margin="0,0,0,35">

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        Text="Have a project code?"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Enter the code shared by your team lead to find and request to join a project."
                        FontSize="13"
                        LineHeight="1.2"
                        TextColor="{AppThemeBinding Light=#666666, Dark=#B8B8B8}" />

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8"
                        Margin="0,5,0,0">

                        <Entry
                            x:Name="ProjectCodeEntry"
                            Placeholder="Project code"
                            FontSize="14"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                            PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#292929}"
                            HeightRequest="50" />

                        <Button
                            Grid.Column="1"
                            Text="Search"
                            BackgroundColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                            TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}"
                            CornerRadius="18"
                            HeightRequest="50"
                            Padding="18,0"
                            FontAttributes="Bold" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Features -->

            <VerticalStackLayout
                Spacing="18"
                Margin="0,0,0,30">

                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Text="Everything in one place."
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Keep your entire university project organised."
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                </VerticalStackLayout>

                <Border
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="PROJECTS"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        <Label
                            Text="Create and organise"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <Label
                            Text="Keep your university projects, teams and important information together."
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="TASKS"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        <Label
                            Text="Know what needs to be done"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <Label
                            Text="Assign work, track progress and stay ahead of deadlines."
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="CALENDAR"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        <Label
                            Text="Never miss an important date"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <Label
                            Text="See project deadlines, tasks and milestones in one calendar."
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="TEAM CHAT"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        <Label
                            Text="Stay connected"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <Label
                            Text="Communicate with your team and keep project conversations together."
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <!-- Footer -->

            <VerticalStackLayout
                Spacing="7"
                HorizontalOptions="Center"
                Margin="0,10,0,0">

                <Label
                    Text="UniConnect"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="A workspace for university teams."
                    FontSize="12"
                    TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="About  •  Help  •  Privacy"
                    FontSize="12"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                    HorizontalTextAlignment="Center"
                    Margin="0,5,0,0" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
