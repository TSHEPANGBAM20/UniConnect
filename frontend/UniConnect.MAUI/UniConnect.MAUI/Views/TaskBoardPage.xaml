<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="UniConnect.MAUI.Views.TaskBoardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:UniConnect.MAUI.Models"
    Title="Project Workspace"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}">

    <Grid MaximumWidthRequest="500">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,24,24,18"
            Spacing="14">

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="5">

                    <Label
                        Text="PROJECT WORKSPACE"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                    <Label
                        Text="Tasks"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="Chat"
                    Clicked="OnChatClicked"
                    BackgroundColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                    TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}"
                    CornerRadius="20"
                    HeightRequest="42"
                    Padding="18,0"
                    FontSize="13"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

            </Grid>

            <!-- Task summary -->
            <Border
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1C1C1C}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                Padding="16">

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="3">

                        <Label
                            Text="Your project tasks"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <Label
                            Text="Keep track of deadlines and progress."
                            FontSize="12"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="{Binding Tasks.Count, StringFormat='{0} tasks'}"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

        </VerticalStackLayout>

        <!-- Tasks -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Tasks}"
            Margin="24,0,24,24"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Spacing="8"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="30">

                    <Label
                        Text="No tasks yet"
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Tasks for this project will appear here."
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:TaskModel">

                    <Border
                        Margin="0,0,0,12"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
                        Stroke="{AppThemeBinding Light=#E3E3E3, Dark=#333333}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="10">

                            <!-- Task title -->
                            <Label
                                Text="{Binding TaskTitle}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                            <!-- Description -->
                            <Label
                                Text="{Binding TaskDescription}"
                                FontSize="13"
                                LineBreakMode="WordWrap"
                                TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                            <!-- Details -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        Text="DUE"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1"
                                        TextColor="{AppThemeBinding Light=#999999, Dark=#777777}" />

                                    <Label
                                        Text="{Binding DueDate, StringFormat='{0:dd MMM yyyy}'}"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}" />

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                    <Label
                                        Text="ASSIGNED TO"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1"
                                        TextColor="{AppThemeBinding Light=#999999, Dark=#777777}" />

                                    <Label
                                        Text="{Binding AssignedToName}"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}" />

                                </VerticalStackLayout>

                            </Grid>

                            <!-- Status -->
                            <Border
                                HorizontalOptions="Start"
                                Padding="10,5"
                                BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">

                                <Label
                                    Text="{Binding Status}"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}" />

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout>
                        <Label Text="When you are done with a task, press the 'Done' button."
                               FontSize="11" TextColor="Gray" Margin="4,4,4,0" />
                        <BoxView HeightRequest="120" Color="Transparent" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>

        <!-- Loading -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
            VerticalOptions="Start"
            Margin="0,12,0,0" />

    </Grid>

</ContentPage>