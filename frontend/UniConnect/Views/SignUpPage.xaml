<?xml version="1.0" encoding="utf-8" ?>

<!--
    UniConnect - Sign Up Page

    PURPOSE:
    This page allows a new user to create a UniConnect account.

    FUTURE FUNCTIONALITY:
    - Collect the user's name
    - Collect their email address
    - Create a password
    - Confirm the password
    - Validate the information
    - Send registration details to the Java Spring Boot backend
    - Handle successful registration and errors
-->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UniConnect.MAUI.SignUpPage"
    Title="Sign Up">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <!-- Application name -->
            <Label
                Text="UniConnect"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Page heading -->
            <Label
                Text="Create Account"
                FontSize="24"
                HorizontalOptions="Center" />

            <!-- User's name -->
            <Entry
                x:Name="NameEntry"
                Placeholder="Full name" />

            <!-- User's email -->
            <Entry
                x:Name="EmailEntry"
                Placeholder="Email"
                Keyboard="Email" />

            <!-- Password -->
            <Entry
                x:Name="PasswordEntry"
                Placeholder="Password"
                IsPassword="True" />

            <!-- Confirm password -->
            <Entry
                x:Name="ConfirmPasswordEntry"
                Placeholder="Confirm password"
                IsPassword="True" />

            <!--
                Create account button.

                FUTURE:
                Connect this button to the registration logic
                and SignUpViewModel when it is implemented.
            -->
            <Button
                x:Name="SignUpButton"
                Text="Create Account"
                HorizontalOptions="Fill" />

            <!--
                Future status area.
                This can display validation messages,
                registration errors, or success messages.
            -->
            <Label
                x:Name="StatusMessageLabel"
                Text=""
                IsVisible="False"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>