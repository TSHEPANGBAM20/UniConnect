<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UniConnect.Views.SignUpPage"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <Grid Padding="30">

            <VerticalStackLayout
                WidthRequest="350"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="15">

                <!-- UniConnect -->
                <Label
                    Text="UniConnect"
                    FontSize="34"
                    FontAttributes="Bold"
                    TextColor="Black"
                    HorizontalOptions="Center"
                    Margin="0,0,0,10" />

                <!-- Page title -->
                <Label
                    Text="Create Account"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="Black"
                    HorizontalOptions="Center"
                    Margin="0,0,0,10" />

                <!-- Full name -->
                <Entry
                    x:Name="NameEntry"
                    Placeholder="Full Name"
                    HeightRequest="50" 
                    TextColor="Black"
                    PlaceholderColor="Gray"
                    />

                <!-- Email -->
                <Entry
                    x:Name="EmailEntry"
                    Placeholder="Email"
                    Keyboard="Email"
                    HeightRequest="50" 
                    TextColor="Black"
                    PlaceholderColor="Gray"/>

                <!-- Password -->
                <Grid ColumnDefinitions="*,Auto">

                    <Entry
                        x:Name="PasswordEntry"
                        Grid.Column="0"
                        Placeholder="Password"
                        IsPassword="True"
                        HeightRequest="50" 
                        TextColor="Black"
                        PlaceholderColor="Gray"
                      />

                    <Label
                        x:Name="ShowPasswordLabel"
                        Grid.Column="1"
                        Text="Show"
                        TextColor="Black"
                        FontAttributes="Bold"
                        VerticalOptions="Center"
                        Margin="10,0,0,0">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnTogglePasswordVisibility" />
                        </Label.GestureRecognizers>

                    </Label>

                </Grid>

                <!-- Confirm password -->
                <Entry
                    x:Name="ConfirmPasswordEntry"
                    Placeholder="Confirm Password"
                    IsPassword="True"
                    HeightRequest="50"
                    TextColor="Black"
                    PlaceholderColor="Gray"
                    />

                <!-- Error message -->
                <Label
                    x:Name="ErrorLabel"
                    Text=""
                    TextColor="Red"
                    FontSize="13"
                    HorizontalOptions="Center" />

                <!-- Sign Up button -->
                <Button
                    Text="Sign Up"
                    Clicked="OnSignUpClicked"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Margin="0,5,0,0" />

                <!-- Already have account -->
                <Label
                    Text="Already have an account? Log In"
                    TextColor="Gray"
                    FontSize="13"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnLoginTapped" />
                    </Label.GestureRecognizers>

                </Label>

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>
