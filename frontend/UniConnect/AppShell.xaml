<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="UniConnect.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:UniConnect.Views"
    Title="UniConnect">

    <!--
        LoginPage is currently the first page users see.
        We will add navigation to Dashboard and other pages later.
    -->

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

</Shell>
